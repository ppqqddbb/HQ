# 应用运行环境
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# 项目根目录相对路径；程序以项目根目录为基准解析，不要填写机器专属绝对路径
DATA_DIR=data
ARTIFACTS_DIR=artifacts
LOG_DIR=logs

# DuckDB 分析引擎资源
DUCKDB_MEMORY_LIMIT=12GB

# 本机 Python 环境标识（仅供开发参考，不写入业务代码）
PYTHON_CONDA_ENV=py310
PYTHON_PATH=

# 身份认证与授权（技术方案 16.1）
# off：本地单机开发模式，不校验令牌（默认）；
# on ：所有 /api/v1/* 除 /health 与 /whoami 外都必须携带令牌。
AISP_AUTH=off
# 令牌 → 角色，逗号分隔。角色可选：admin / data_manager / analyst / viewer / auditor
# 示例：AISP_TOKENS=mySecretToken=admin,readonlyToken=viewer
# 注意：生产环境请改用企业 IAM/LDAP/OIDC，不要把真实令牌写进版本库。
# 正常情况下建议留空：用户与令牌在「系统管理 → 用户与角色」页面维护（存元数据库，
# 令牌只存 SHA-256 摘要），优点是可随时删除/停用而不需要重启服务。
# 首次启动无可用管理员时，日志里会打印一次内置 system 管理员的令牌。
AISP_TOKENS=
